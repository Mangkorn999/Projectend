generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id     Int    @id @default(autoincrement())
  role_name   String @db.VarChar(50)
  description String @db.VarChar(255)
  users       User[]

  @@map("roles")
}

model User {
  user_id         Int               @id @default(autoincrement())
  role_id         Int
  psu_passport_id String            @unique @db.VarChar(100)
  // login ในระบบเอง (PSU SSO ขอใช้ไม่ได้) — เก็บเฉพาะ bcrypt hash ห้ามเก็บรหัสจริง
  // must_change_password = ยังใช้รหัสเริ่มต้นอยู่ ต้องบังคับตั้งใหม่ก่อนใช้งาน
  password_hash        String?      @db.VarChar(255)
  must_change_password Boolean      @default(true)
  // นักศึกษา: ว่างตอน import จนกว่าจะกรอกโปรไฟล์ครั้งแรก (เจ้าหน้าที่/ผู้บริหารยังกรอกตอนสร้างบัญชีเหมือนเดิม)
  first_name      String?           @db.VarChar(100)
  last_name       String?           @db.VarChar(100)
  email           String?           @db.VarChar(100)
  phone           String?           @db.VarChar(20)
  created_at      DateTime          @default(now())
  confirmed_exams ExamResult[]      @relation("UserToExamResult")
  news            News[]            @relation("UserToNews")
  student         Student?
  created_rounds  SubmissionRound[] @relation("UserToRound")
  role            Role              @relation(fields: [role_id], references: [role_id])

  @@map("users")
}

model Faculty {
  faculty_id   Int       @id @default(autoincrement())
  faculty_name String    @db.VarChar(150)
  students     Student[]

  @@map("faculties")
}

model Room {
  room_id   Int       @id @default(autoincrement())
  room_name String    @db.VarChar(20)
  students  Student[]

  @@map("rooms")
}

model Student {
  student_id               String       @id @db.VarChar(20)
  user_id                  Int          @unique
  faculty_id               Int
  academic_year            Int
  room_id                  Int
  // ชื่อ-สกุลภาษาอังกฤษ — ใช้ออกเอกสาร/ใบประกอบวิชาชีพ กรอกตอน complete-profile ครั้งแรกพร้อมกับสร้างแถวนี้เลย
  first_name_en            String       @db.VarChar(100)
  last_name_en             String       @db.VarChar(100)
  exam_results             ExamResult[]
  notifications            Notification[]
  // เปิดสิทธิ์กรอกผลสอบให้อัตโนมัติตั้งแต่เพิ่มนักศึกษาเข้าระบบ — เจ้าหน้าที่ค่อยกดถอนสิทธิ์เองถ้าไม่ต้องการ
  exam_eligible Boolean @default(true)
  faculty                  Faculty      @relation(fields: [faculty_id], references: [faculty_id])
  room                     Room         @relation(fields: [room_id], references: [room_id])
  user                     User         @relation(fields: [user_id], references: [user_id])

  @@map("students")
}

model Subject {
  subject_id   Int             @id @default(autoincrement())
  subject_code String          @db.VarChar(10)
  subject_name String          @db.VarChar(200)
  results      SubjectResult[]

  @@map("subjects")
}

model SubmissionRound {
  round_id       Int          @id @default(autoincrement())
  created_by     Int
  academic_year  Int
  attempt_number Int
  open_date      DateTime
  close_date     DateTime
  status         String       @db.VarChar(10)
  // วิชาที่รอบนี้ทดสอบ — ไม่ใช่ทุกรอบต้องครบ 8 วิชา
  // ว่าง [] = ใช้ทุกวิชา (รอบเก่าที่สร้างก่อนมี column นี้)
  subject_ids    Int[]
  exam_results   ExamResult[]
  news           News[]
  creator        User         @relation("UserToRound", fields: [created_by], references: [user_id])

  // หนึ่งรุ่นมีสอบครั้งที่ n ได้ครั้งเดียว — กันรอบซ้ำที่ระดับ DB ไม่ใช่แค่ที่ controller
  @@unique([academic_year, attempt_number])
  @@map("submission_rounds")
}

model ExamResult {
  result_id       Int             @id @default(autoincrement())
  student_id      String          @db.VarChar(20)
  round_id        Int
  confirmed_by    Int?
  student_status  String          @db.VarChar(15)
  staff_status    String          @db.VarChar(20)
  remark          String?
  submitted_at    DateTime        @default(now())
  confirmed_at    DateTime?
  certificates    Certificate[]
  confirmer       User?           @relation("UserToExamResult", fields: [confirmed_by], references: [user_id])
  round           SubmissionRound @relation(fields: [round_id], references: [round_id])
  student         Student         @relation(fields: [student_id], references: [student_id])
  subject_results SubjectResult[]

  @@map("exam_results")
}

model SubjectResult {
  subject_result_id Int        @id @default(autoincrement())
  result_id         Int
  subject_id        Int
  is_passed         Boolean
  // true = ไม่ได้สอบวิชานี้ในรอบนี้ ผลผ่านยกมาจากรอบก่อน (copy-forward)
  // แยกไว้ให้สถิติรายวิชานับเฉพาะคนที่สอบจริง
  // default false = แถวเก่าก่อนมี column นี้ ถือว่าสอบจริงทั้งหมด
  carried_forward   Boolean    @default(false)
  exam_result       ExamResult @relation(fields: [result_id], references: [result_id])
  subject           Subject    @relation(fields: [subject_id], references: [subject_id])

  @@map("subject_results")
}

model Certificate {
  certificate_id   Int        @id @default(autoincrement())
  result_id        Int
  certificate_type String     @db.VarChar(20)
  file_name        String     @db.VarChar(255)
  file_path        String     @db.VarChar(500)
  file_type        String     @db.VarChar(10)
  uploaded_at      DateTime   @default(now())
  exam_result      ExamResult @relation(fields: [result_id], references: [result_id])

  @@map("certificates")
}

model News {
  news_id    Int             @id @default(autoincrement())
  posted_by  Int
  round_id   Int
  title      String          @db.VarChar(255)
  content    String
  // รูปภาพประกอบ 1 รูป (ไม่บังคับ) — เก็บแค่ path ไฟล์จริงอยู่ที่ disk
  image_path String?         @db.VarChar(255)
  posted_at  DateTime        @default(now())
  updated_at DateTime        @updatedAt
  poster     User            @relation("UserToNews", fields: [posted_by], references: [user_id])
  round      SubmissionRound @relation(fields: [round_id], references: [round_id])

  @@map("news")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  student_id      String   @db.VarChar(20)
  type            String   @db.VarChar(20) // approved | rejected | eligible
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())
  student         Student  @relation(fields: [student_id], references: [student_id])

  @@map("notifications")
}
