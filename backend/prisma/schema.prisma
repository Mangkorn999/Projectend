generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id     Int    @id @default(autoincrement())
  role_name   String @db.VarChar(50)
  description String @db.VarChar(255)
  users       User[]

  @@map("roles")
}

model User {
  user_id         Int               @id @default(autoincrement())
  role_id         Int
  psu_passport_id String            @unique @db.VarChar(100)
  // login ในระบบเอง (PSU SSO ขอใช้ไม่ได้) — เก็บเฉพาะ bcrypt hash ห้ามเก็บรหัสจริง
  // must_change_password = ยังใช้รหัสเริ่มต้นอยู่ ต้องบังคับตั้งใหม่ก่อนใช้งาน
  password_hash        String?      @db.VarChar(255)
  must_change_password Boolean      @default(true)
  // นักศึกษา: ว่างตอน import จนกว่าจะกรอกโปรไฟล์ครั้งแรก (เจ้าหน้าที่/ผู้บริหารยังกรอกตอนสร้างบัญชีเหมือนเดิม)
  first_name      String?           @db.VarChar(100)
  last_name       String?           @db.VarChar(100)
  email           String?           @db.VarChar(100)
  phone           String?           @db.VarChar(20)
  // นักศึกษา: ปีการศึกษาที่จบที่เจ้าหน้าที่ระบุตอนนำเข้า (เคสซ้ำชั้น/ลาพัก) — ว่าง = คำนวณจากรหัส (รหัส+4)
  // เก็บที่ users เพราะตอน import ยังไม่มีแถว students ให้เก็บ — complete-profile อ่านค่านี้ไปตั้ง students.academic_year
  import_academic_year Int?
  created_at      DateTime          @default(now())
  confirmed_exams ExamResult[]      @relation("UserToExamResult")
  news            News[]            @relation("UserToNews")
  student         Student?
  created_rounds  SubmissionRound[] @relation("UserToRound")
  role            Role              @relation(fields: [role_id], references: [role_id])
  review_logs     ReviewLog[]

  @@map("users")
}

model Faculty {
  faculty_id   Int       @id @default(autoincrement())
  faculty_name String    @db.VarChar(150)
  students     Student[]

  @@map("faculties")
}

model Room {
  room_id   Int       @id @default(autoincrement())
  room_name String    @db.VarChar(20)
  students  Student[]

  @@map("rooms")
}

model Student {
  student_id               String       @id @db.VarChar(20)
  user_id                  Int          @unique
  faculty_id               Int
  academic_year            Int
  room_id                  Int
  // ชื่อ-สกุลภาษาอังกฤษ — ใช้ออกเอกสาร/ใบประกอบวิชาชีพ กรอกตอน complete-profile ครั้งแรกพร้อมกับสร้างแถวนี้เลย
  first_name_en            String       @db.VarChar(100)
  last_name_en             String       @db.VarChar(100)
  exam_results             ExamResult[]
  notifications            Notification[]
  // เปิดสิทธิ์กรอกผลสอบให้อัตโนมัติตั้งแต่เพิ่มนักศึกษาเข้าระบบ — เจ้าหน้าที่ค่อยกดถอนสิทธิ์เองถ้าไม่ต้องการ
  exam_eligible Boolean @default(true)
  faculty                  Faculty      @relation(fields: [faculty_id], references: [faculty_id])
  room                     Room         @relation(fields: [room_id], references: [room_id])
  user                     User         @relation(fields: [user_id], references: [user_id])

  // dashboard กรองนักศึกษาตามรุ่นแทบทุกหน้า — ไม่มี index จะไล่อ่านทั้งตารางทุกครั้ง
  @@index([academic_year])
  @@map("students")
}

model Subject {
  subject_id   Int             @id @default(autoincrement())
  subject_code String          @db.VarChar(10)
  subject_name String          @db.VarChar(200)
  results      SubjectResult[]

  @@map("subjects")
}

model SubmissionRound {
  round_id       Int          @id @default(autoincrement())
  created_by     Int
  academic_year  Int
  attempt_number Int
  open_date      DateTime
  close_date     DateTime
  status         String       @db.VarChar(10)
  // วิชาที่รอบนี้ทดสอบ — ไม่ใช่ทุกรอบต้องครบ 8 วิชา
  // ว่าง [] = ใช้ทุกวิชา (รอบเก่าที่สร้างก่อนมี column นี้)
  subject_ids    Int[]
  exam_results   ExamResult[]
  news           News[]
  creator        User         @relation("UserToRound", fields: [created_by], references: [user_id])

  // หนึ่งรุ่นมีสอบครั้งที่ n ได้ครั้งเดียว — กันรอบซ้ำที่ระดับ DB ไม่ใช่แค่ที่ controller
  @@unique([academic_year, attempt_number])
  @@map("submission_rounds")
}

model ExamResult {
  result_id       Int             @id @default(autoincrement())
  student_id      String          @db.VarChar(20)
  round_id        Int
  confirmed_by    Int?
  student_status  String          @db.VarChar(15)
  staff_status    String          @db.VarChar(20)
  remark          String?
  submitted_at    DateTime        @default(now())
  confirmed_at    DateTime?
  certificates    Certificate[]
  confirmer       User?           @relation("UserToExamResult", fields: [confirmed_by], references: [user_id])
  round           SubmissionRound @relation(fields: [round_id], references: [round_id])
  student         Student         @relation(fields: [student_id], references: [student_id])
  subject_results SubjectResult[]
  review_logs     ReviewLog[]

  // นักศึกษา 1 คนมีได้ใบเดียวต่อรอบ — กันที่ระดับ DB ไม่ใช่แค่ที่ controller
  // เดิมกันด้วย findByStudentAndRound() ใน controller อย่างเดียว ซึ่งมีช่องว่าง:
  // กดส่ง 2 ครั้งรัวๆ (หรือเน็ตกระตุกแล้ว browser ยิงซ้ำ) 2 request จะเช็ค "ยังไม่มีใบ"
  // พร้อมกันก่อนที่ใครจะเขียนเสร็จ → ได้ 2 ใบในรอบเดียว แล้ว findFirst หยิบใบไหนก็ไม่แน่นอน
  @@unique([student_id, round_id])
  // unique ข้างบนใช้ค้นด้วย student_id ได้อยู่แล้ว (เป็นคอลัมน์แรก)
  // แต่ค้นด้วย round_id อย่างเดียวใช้ไม่ได้ — คิวตรวจของเจ้าหน้าที่กรองด้วย 2 ตัวนี้เป็นหลัก
  @@index([round_id])
  @@index([staff_status])
  @@map("exam_results")
}

// Insert-only — ทุกครั้งที่ approve/reject 1 แถว ไม่ทับของเดิมเหมือน exam_results.confirmed_by
model ReviewLog {
  log_id      Int        @id @default(autoincrement())
  result_id   Int
  reviewer_id Int
  action      String     @db.VarChar(20) // "approved" | "rejected"
  remark      String?    @db.Text // snapshot ของ remark ตอนตรวจครั้งนั้น (ถ้ามี)
  created_at  DateTime   @default(now())
  exam_result ExamResult @relation(fields: [result_id], references: [result_id])
  reviewer    User       @relation(fields: [reviewer_id], references: [user_id])

  // ดึงประวัติการตรวจของใบหนึ่ง — ตารางนี้โตเรื่อยๆ (insert-only) ต้องมี index
  @@index([result_id])
  @@map("review_logs")
}

model SubjectResult {
  subject_result_id Int        @id @default(autoincrement())
  result_id         Int
  subject_id        Int
  is_passed         Boolean
  // true = ไม่ได้สอบวิชานี้ในรอบนี้ ผลผ่านยกมาจากรอบก่อน (copy-forward)
  // แยกไว้ให้สถิติรายวิชานับเฉพาะคนที่สอบจริง
  // default false = แถวเก่าก่อนมี column นี้ ถือว่าสอบจริงทั้งหมด
  carried_forward   Boolean    @default(false)
  exam_result       ExamResult @relation(fields: [result_id], references: [result_id])
  subject           Subject    @relation(fields: [subject_id], references: [subject_id])

  // ตารางใหญ่สุดในระบบ (นักศึกษา 1 คน × 8 วิชา × ทุกรอบ)
  // result_id ใช้ตอน join กลับไปหาใบ, subject_id ใช้ตอนทำสถิติรายวิชาใน dashboard
  @@index([result_id])
  @@index([subject_id])
  @@map("subject_results")
}

model Certificate {
  certificate_id   Int        @id @default(autoincrement())
  result_id        Int
  certificate_type String     @db.VarChar(20)
  file_name        String     @db.VarChar(255)
  file_path        String     @db.VarChar(500)
  file_type        String     @db.VarChar(10)
  uploaded_at      DateTime   @default(now())
  exam_result      ExamResult @relation(fields: [result_id], references: [result_id])

  // หาเอกสารของใบหนึ่ง — ใช้ทั้งตอนแสดงรายการและตอนอัปโหลดทับใบเก่า
  @@index([result_id])
  @@map("certificates")
}

model News {
  news_id    Int             @id @default(autoincrement())
  posted_by  Int
  round_id   Int
  title      String          @db.VarChar(255)
  content    String
  // รูปภาพประกอบ 1 รูป (ไม่บังคับ) — เก็บแค่ path ไฟล์จริงอยู่ที่ disk
  image_path String?         @db.VarChar(255)
  posted_at  DateTime        @default(now())
  updated_at DateTime        @updatedAt
  poster     User            @relation("UserToNews", fields: [posted_by], references: [user_id])
  round      SubmissionRound @relation(fields: [round_id], references: [round_id])

  @@index([round_id])
  @@map("news")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  student_id      String   @db.VarChar(20)
  type            String   @db.VarChar(20) // approved | rejected | eligible
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())
  student         Student  @relation(fields: [student_id], references: [student_id])

  // นักศึกษาเปิดกระดิ่งทีนึง = query ด้วย student_id ทุกครั้ง (frontend poll ทุก 30 วิด้วย)
  @@index([student_id])
  @@map("notifications")
}
